# @meddleware/status-page — build-time environment
# Copy to .env.local for local dev (never commit .env.local).

# Base URL of the platform-probe `/api/status` endpoint. Empty (the default) means same-origin:
# the ingress routes /api/ to platform-probe. Set it only when the probe is on another origin.
# VITE_API_BASE=https://status.meddleware.co.uk
