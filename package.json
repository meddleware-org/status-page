{
  "name": "@meddleware/status-ui",
  "private": true,
  "version": "0.1.24",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -p tsconfig.build.json && vite build",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:css": "stylelint \"src/**/*.{css,vue}\"",
    "lint:js": "eslint .",
    "lint": "npm run lint:css && npm run lint:js && npm run lint:html",
    "lint:html": "html-validate \"src/**/*.vue\"",
    "licenses": "node scripts/third-party-licenses.mjs",
    "check:licenses": "node scripts/third-party-licenses.mjs --check",
    "check:csp": "node scripts/check-csp-inline.mjs @Dockerfile dist"
  },
  "dependencies": {
    "@meddleware/design-tokens": "^0.1.10",
    "@meddleware/ui": "^0.1.34",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@types/node": "~26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.2",
    "html-validate": "^11.17.0",
    "html-validate-vue": "^9.3.1",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.5",
    "vitest": "~5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "~3.3.13"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ]
}
